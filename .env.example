# Copy to .env and fill in. Never commit .env.

# Hugging Face token. google/medgemma-1.5-4b-it is gated: open its model page while logged in and
# accept the Health AI Developer Foundations terms first.
HF_TOKEN=

# Embeddings
EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
# Matryoshka size: 384 | 512 | 768 | 1024 | 2048 (blank = 2048). Changing it requires a new Pinecone index.
EMBED_DIM=
# cpu | cuda | mps (blank = auto)
EMBED_DEVICE=

# Reasoning model: local (transformers on this machine) | endpoint (HF Inference / TGI / vLLM) | none (rules only)
LLM_BACKEND=local
# Medical fine-tune of Gemma 3 4B. Plain google/gemma-3-4b-it also works with the same code.
LLM_MODEL=google/medgemma-1.5-4b-it
# For LLM_BACKEND=endpoint: either a dedicated endpoint / self-hosted TGI or vLLM URL...
LLM_ENDPOINT_URL=
# ...or a Hugging Face Inference Provider name (leave blank for the default)
HF_PROVIDER=
LLM_MAX_NEW_TOKENS=700

# Retrieval: auto (Pinecone if key set, else on-device) | pinecone | local | off
RETRIEVAL=auto
RETRIEVAL_K=3
PINECONE_API_KEY=
PINECONE_INDEX=medmesh-sentinel
PINECONE_NAMESPACE=triage-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
